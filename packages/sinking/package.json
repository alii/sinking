{
	"name": "sinking",
	"version": "0.0.1",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./core": "./dist/core.js",
		"./worker": "./dist/worker.js",
		"./react": "./dist/react.js"
	},
	"files": [
