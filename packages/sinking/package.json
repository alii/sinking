{
	"name": "sinking",
	"version": "0.0.4",
	"description": "Cross-tab IndexedDB sync via SharedWorker",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./core": "./dist/core.js",
		"./worker": "./dist/worker.js",
		"./react": "./dist/react.js"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Alistair Smith",
		"url": "https://alistair.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alii/sinking.git",
		"directory": "packages/sinking"
	},
	"homepage": "https://github.com/alii/sinking#readme",
	"bugs": {
		"url": "https://github.com/alii/sinking/issues"
	},
	"keywords": [
		"indexeddb",
		"sharedworker",
		"cross-tab",
		"sync",
		"offline",
		"react",
		"hooks"
	],
	"files": [
		"./package.json",
		"./dist",
		"./README.md"
	],
	"scripts": {
		"release": "bun run build && bun publish --access public",
		"build": "bunup src/core.ts src/worker.ts src/react.ts --format esm --dts.resolve --dts.splitting --packages bundle --external react"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@sinking/core": "workspace:*",
		"@sinking/react": "workspace:*",
		"@sinking/worker": "workspace:*",
		"bunup": "^0.16.22"
	}
}
